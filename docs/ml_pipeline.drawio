<mxfile host="app.diagrams.net" modified="2026-06-09T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram name="WatchTower ML Detection Pipeline" id="watchtower-ml-pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ─── NODES ─────────────────────────────────────────── -->

        <!-- CSV / PCAP Input -->
        <mxCell id="n_input" value="CSV / PCAP"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontColor=#004c8c;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="375" y="30" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Ingestion + Preprocessing -->
        <mxCell id="n_ingest" value="Ingestion + Preprocessing"
          style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;fontColor=#4d3c00;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="130" width="720" height="65" as="geometry" />
        </mxCell>

        <!-- Junction dot (invisible hub where the three branches split) -->
        <mxCell id="n_hub" value=""
          style="ellipse;aspect=fixed;fillColor=#555555;strokeColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="446" y="238" width="8" height="8" as="geometry" />
        </mxCell>

        <!-- Random Forest -->
        <mxCell id="n_rf" value="&lt;b&gt;Random Forest&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Supervised)&lt;/i&gt;"
          style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a4d1a;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="280" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- XGBoost -->
        <mxCell id="n_xgb" value="&lt;b&gt;XGBoost&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Supervised)&lt;/i&gt;"
          style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a4d1a;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="280" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Isolation Forest -->
        <mxCell id="n_if" value="&lt;b&gt;Isolation Forest&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Unsupervised)&lt;/i&gt;"
          style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#4d2b00;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="610" y="280" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Fusion Layer -->
        <mxCell id="n_fusion" value="&lt;b&gt;Fusion Layer&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(4 strategies)&lt;/i&gt;"
          style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#3d1a4d;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="170" y="460" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Final Predictions -->
        <mxCell id="n_output" value="&lt;b&gt;Final Predictions&lt;/b&gt;&lt;br/&gt;label / attack_type&lt;br/&gt;confidence / scores"
          style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#4d0000;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="160" y="620" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- ─── EDGES ──────────────────────────────────────────── -->

        <!-- Input → Ingestion -->
        <mxCell id="e1" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="n_input" target="n_ingest" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ingestion → Hub  (carries the feature-matrix label) -->
        <mxCell id="e2" value="70-feature float32 matrix"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#555555;fontStyle=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="n_ingest" target="n_hub" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hub → Random Forest -->
        <mxCell id="e3" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#82b366;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="n_hub" target="n_rf" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hub → XGBoost -->
        <mxCell id="e4" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="n_hub" target="n_xgb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hub → Isolation Forest -->
        <mxCell id="e5" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="n_hub" target="n_if" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Random Forest → Fusion  (enters left side) -->
        <mxCell id="e6" value="preds1 / proba1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#82b366;fontStyle=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="n_rf" target="n_fusion" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- XGBoost → Fusion  (enters top center) -->
        <mxCell id="e7" value="preds2 / proba2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#82b366;fontStyle=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="n_xgb" target="n_fusion" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Isolation Forest → Fusion  (enters right side — IF Escalation) -->
        <mxCell id="e8" value="if_preds / if_scores&#xa;(IF Escalation)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#d79b00;fontStyle=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="n_if" target="n_fusion" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fusion → Final Predictions -->
        <mxCell id="e9" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="n_fusion" target="n_output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
